<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#fff"/><title>Directory — Flagmade</title><meta name="description" content="Independent restaurants, local food shops, farmstands, makers and shops in Flagstaff."/><link rel="canonical" href="https://flagmade.pages.dev/directory/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<header class="site-header"><div class="header-inner container"><a class="brand" href="/">flagmade</a><nav aria-label="Main navigation"><a href="/">Events</a><a href="/local-food/">Local Food</a><a href="/directory/" aria-current="page">Directory</a></nav></div></header>
<main class="container directory-page"><h1>Directory</h1><p>Local restaurants, food stands, makers & shops in Flagstaff.</p>
<div class="directory-layout"><section><label for="place-search">Search</label><input id="place-search" type="search" placeholder="Business or product"><label for="place-type">Category</label><select id="place-type"><option value="">All categories</option><option>Restaurants</option><option>Food & farmstands</option><option>Makers & shops</option></select><div class="directory-items">{listings.map(p=><article class="directory-item" data-type={p.type} data-id={p.id}><p class="directory-kind">{p.type}</p><h2><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name} ↗</a></h2><p>{p.description}</p><p class="directory-address">{p.address}</p>{p.coordinates ? <button class="map-focus" data-id={p.id}>Show on map</button> : <a class="map-focus" href={'https://www.openstreetmap.org/search?query='+encodeURIComponent(p.address)} target="_blank" rel="noopener noreferrer">Map address ↗</a>}</article>)}</div></section><aside><div id="directory-map" role="region" aria-label="Map of directory locations"></div><p class="map-status" id="map-status">Verified street addresses are listed below; map pins are shown only where coordinates have been assigned.</p></aside></div></main>
<script id="places-data" type="application/json" set:html={JSON.stringify(listings).replace(/</g,'\\u003c')}></script>

<script>
import L from 'leaflet';
import 'leaflet.markercluster';
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
(function(){
  const status=document.getElementById('map-status');
  const records=JSON.parse(document.getElementById('places-data').textContent||'[]');
  const select=document.getElementById('place-type');
  const search=document.getElementById('place-search');
  const cards=[...document.querySelectorAll('.directory-item')];
  let map=null, cluster=null;
  const markers=new Map();
  const safe=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function matches(p){return (!select.value||select.value===p.type)&&(!search.value.trim()||[p.name,p.type,p.description,p.address].join(' ').toLowerCase().includes(search.value.trim().toLowerCase()));}
  function update(){
    const visible=new Set(records.filter(matches).map(p=>p.id));
    for(const card of cards)card.hidden=!visible.has(card.dataset.id);
    if(cluster){cluster.clearLayers();for(const id of visible){const marker=markers.get(id);if(marker)cluster.addLayer(marker);}}
    status.textContent=visible.size+' listings shown'+(markers.size<records.length?'; some addresses are not yet mapped':'');
  }
  // Filters work independently of map CDN availability.
  select.addEventListener('change',update);
  search.addEventListener('input',update);
  if(typeof L.markerClusterGroup==='function'){
    try{
      map=L.map('directory-map',{scrollWheelZoom:false}).setView([35.1978,-111.6485],14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors'}).addTo(map);
      cluster=L.markerClusterGroup({showCoverageOnHover:false,spiderfyOnMaxZoom:true,maxClusterRadius:42});
      cluster.addTo(map);
      for(const p of records){
        if(!Array.isArray(p.coordinates))continue;
        const marker=L.marker(p.coordinates,{icon:L.divIcon({className:'directory-point',html:'<span></span>',iconSize:[18,18],iconAnchor:[9,9]})}).bindPopup('<strong>'+safe(p.name)+'</strong><p>'+safe(p.address)+'</p>');
        markers.set(p.id,marker);
      }
      update();
    }catch(error){status.textContent='Map unavailable; directory filters are still active.';map=null;cluster=null;}
  }else{
    status.textContent='Map unavailable; directory filters are still active.';
  }
  for(const button of document.querySelectorAll('.map-focus')){
    button.addEventListener('click',()=>{
      const p=records.find(x=>x.id===button.dataset.id);
      if(!p)return;
      if(!matches(p)){select.value=p.type;search.value='';update();}
      const marker=markers.get(p.id);
      if(!map||!cluster||!marker){status.textContent='Map pin not verified for '+p.name+'. Use the address above.';return;}
      cluster.zoomToShowLayer(marker,()=>{map.setView(marker.getLatLng(),17);marker.openPopup();});
    });
  }
  update();
})();
</script></body></html>