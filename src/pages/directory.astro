---
import '../styles/global.css';
// Map coordinates are approximate downtown placements pending address-level validation. Unverified sites have no pin.
// Map coordinates are approximate street or neighborhood locations, not entrance-level survey points.
import { listings } from '../data/directory.js';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#fff"/><title>Directory — Flagmade</title><meta name="description" content="Independent restaurants, local food shops, farmstands, makers and shops in Flagstaff."/><link rel="canonical" href="https://flagmade.pages.dev/directory/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<header class="site-header"><div class="header-inner container"><a class="brand" href="/">flagmade</a><nav aria-label="Main navigation"><a href="/">Events</a><a href="/local-food/">Local Food</a><a href="/directory/" aria-current="page">Directory</a><a href="/search/">Search</a></nav></div></header>
<main class="container directory-page"><h1>Directory</h1><p>Local restaurants, food stands, makers & shops in Flagstaff.</p><div id="directory-full-search"></div>
<div class="directory-layout"><section><label for="place-search">Search</label><input id="place-search" type="search" placeholder="Business or product"><label for="place-type">Category</label><select id="place-type"><option value="">All categories</option><option>Restaurants</option><option>Food & farmstands</option><option>Makers & shops</option></select><p id="directory-count" class="directory-count"></p><div class="directory-items">{listings.map(p=><article class="directory-item" data-type={p.type} data-id={p.id}><p class="directory-kind">{p.type}</p><h2><a href={"/places/"+p.id+"/"}>{p.name}</a></h2><p>{p.description}</p><p class="directory-address">{p.address}</p><div class="directory-links"><a href={"/places/"+p.id+"/"}>View details</a> {p.coordinates && <button class="map-focus" data-id={p.id}>Show on map</button>}</div></article>)}</div><nav class="directory-pagination" aria-label="Directory pages"><button id="dir-prev" type="button">Previous</button><span id="dir-page"></span><button id="dir-next" type="button">Next</button></nav></section><aside><div id="directory-map" role="region" aria-label="Map of directory locations"></div><p class="map-status" id="map-status">Verified street addresses are listed below; map pins are shown only where coordinates have been assigned.</p></aside></div></main>
<script id="places-data" type="application/json" set:html={JSON.stringify(listings).replace(/</g,'\\u003c')}></script>

<script>
import L from 'leaflet';
import 'leaflet.markercluster';
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
(function(){
  const status=document.getElementById('map-status');
  const records=JSON.parse(document.getElementById('places-data').textContent||'[]');
  const select=document.getElementById('place-type');
  const search=document.getElementById('place-search');
  const cards=[...document.querySelectorAll('.directory-item')];
  let page=1;const perPage=12;const back=document.getElementById("dir-prev"),forward=document.getElementById("dir-next"),pager=document.getElementById("dir-page"),counter=document.getElementById("directory-count");
  let map=null, cluster=null;
  const markers=new Map();
  const safe=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function matches(p){return (!select.value||select.value===p.type)&&(!search.value.trim()||[p.name,p.type,p.description,p.address].join(' ').toLowerCase().includes(search.value.trim().toLowerCase()));}
  function update(resetPage=false){
    const found=records.filter(matches), visible=new Set(found.map(p=>p.id));
    if(resetPage)page=1;
    const pages=Math.max(1,Math.ceil(found.length/perPage));page=Math.min(page,pages);
    const visiblePage=new Set(found.slice((page-1)*perPage,page*perPage).map(p=>p.id));
    for(const card of cards)card.hidden=!visiblePage.has(card.dataset.id);
    if(cluster){cluster.clearLayers();for(const id of visible){const marker=markers.get(id);if(marker)cluster.addLayer(marker);}}
    pager.textContent='Page '+page+' of '+pages;back.disabled=page===1;forward.disabled=page===pages;
    counter.textContent=found.length+' '+(found.length===1?'place':'places');
    status.textContent=found.length+' listings match the filters'+(markers.size<records.length?'; some addresses are not yet mapped':'');
  }
  // Filters work independently of map CDN availability.
  select.addEventListener('change',()=>update(true));
  search.addEventListener('input',()=>update(true));
  back.addEventListener('click',()=>{page--;update();});forward.addEventListener('click',()=>{page++;update();});
  if(typeof L.markerClusterGroup==='function'){
    try{
      map=L.map('directory-map',{scrollWheelZoom:false});
      // Cover Kachina Village (southwest) through Doney Park (northeast) at initial load.
      map.fitBounds([[35.075,-111.715],[35.265,-111.475]],{padding:[12,12]});
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors',className:'flagmade-tiles'}).addTo(map);
      cluster=L.markerClusterGroup({showCoverageOnHover:false,spiderfyOnMaxZoom:true,maxClusterRadius:42});
      cluster.addTo(map);
      for(const p of records){
        if(!Array.isArray(p.coordinates))continue;
        const marker=L.marker(p.coordinates,{icon:L.divIcon({className:'directory-point',html:'<span></span>',iconSize:[18,18],iconAnchor:[9,9]})}).bindPopup('<strong><a href="/places/'+encodeURIComponent(p.id)+'/">'+safe(p.name)+'</a></strong><p>'+safe(p.address)+'</p><a href="/places/'+encodeURIComponent(p.id)+'/">View details</a>');
        markers.set(p.id,marker);
      }
      update();
    }catch(error){status.textContent='Map unavailable; directory filters are still active.';map=null;cluster=null;}
  }else{
    status.textContent='Map unavailable; directory filters are still active.';
  }
  for(const button of document.querySelectorAll('.map-focus')){
    button.addEventListener('click',()=>{
      const p=records.find(x=>x.id===button.dataset.id);
      if(!p)return;
      if(!matches(p)){select.value=p.type;search.value='';update();}
      const marker=markers.get(p.id);
      if(!map||!cluster||!marker){status.textContent='Map pin not verified for '+p.name+'. Use the address above.';return;}
      cluster.zoomToShowLayer(marker,()=>{map.setView(marker.getLatLng(),17);marker.openPopup();});
    });
  }
  update();
})();
</script></body></html>