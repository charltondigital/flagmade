---
import '../styles/global.css';
import '../styles/home.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {listings,placePath} from '../data/directory.js';
import {classifyEvent} from '../lib/event-categories.js';
const all=Object.values(import.meta.glob('../data/events/*.json',{eager:true,import:'default'}));
const now=Date.now();
const upcoming=all.filter(e=>e && e.status==='published' && e.id && e.start && e.title && !Number.isNaN(Date.parse(e.start)) && Date.parse(e.end||e.start)>=now).map(e=>({...e,category:classifyEvent(e)})).sort((a,b)=>Date.parse(a.start)-Date.parse(b.start)).slice(0,5);
const highlights=[
 listings.find(x=>x.id==='brightside'),
 listings.find(x=>x.id==='flagcsa'),
 listings.find(x=>x.id==='pizzicletta')
].filter(Boolean);
const eventDate=(v)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',month:'short',day:'numeric'}).format(new Date(v));
const eventTime=(v)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',hour:'numeric',minute:'2-digit'}).format(new Date(v));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#163F38"/><meta name="description" content="Find Flagstaff events, independent shops, farmers markets, farmstands and local food."/><title>FlagMade | Shop Local, Eat Real Food & Discover Flagstaff</title><link rel="canonical" href="https://flagmade.pages.dev/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="robots" content="noindex, nofollow, noarchive"/></head>
<body><SiteHeader active="Home" />
<main>
<section class="fm-home-intro">
  <div class="container fm-home-intro-layout"><div class="fm-home-intro-inner">
    <h1>Good stuff.<br/><span>Right here.</span></h1>
    <p class="fm-home-summary">Flagstaff events, independent businesses, and locally grown food.</p>
    <div class="fm-home-links">
      <a href="/events/">Explore events <span aria-hidden="true">↗</span></a>
      <a href="/directory/">Find local businesses <span aria-hidden="true">↗</span></a>
      <a href="/local-food/">Shop local food <span aria-hidden="true">↗</span></a>
    </div>
  </div><div class="fm-home-photo"><img src="https://lpcohio.com/wp-content/uploads/2026/08/unsplash-image-H0v6g8FGvFQ.jpg" alt="Shoppers selecting fresh fruit at an outdoor farmers market" width="1000" height="667" fetchpriority="high" decoding="async" /></div></div>
</section>
<section class="fm-home-events"><div class="container">
  <div class="fm-section-heading"><div><h2>Upcoming events</h2></div><a class="fm-section-link" href="/events/">View calendar</a></div>
  {upcoming.length ? <div class="fm-upcoming-list">{upcoming.map(e=><a class="fm-upcoming" href={'/events/?q='+encodeURIComponent(e.title)}><time datetime={e.start} class="fm-upcoming-date">{eventDate(e.start)}</time><span class="fm-upcoming-body"><strong>{e.title}</strong><small>{e.organization} · {e.allDay?'All day':eventTime(e.start)}</small></span></a>)}</div> : <p class="fm-no-events">No upcoming events listed. <a href="/events/">Browse the calendar ↗</a></p>}
</div></section>
{highlights.length > 0 && <section class="container fm-local-spots">
  <div class="fm-section-heading"><div><h2>Local businesses</h2></div><a class="fm-section-link" href="/directory/">View directory</a></div>
  <div class="fm-spots-grid">{highlights.map(p=><a class="fm-spot" href={placePath(p)}><span class="fm-spot-type">{p.type}</span><h3>{p.name}</h3><p>{p.description}</p></a>)}</div>
</section>}
</main><SiteFooter /></body></html>