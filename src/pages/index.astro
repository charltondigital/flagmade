---
import '../styles/global.css';
import '../styles/home.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {listings,placePath} from '../data/directory.js';
import {classifyEvent} from '../lib/event-categories.js';
const all=Object.values(import.meta.glob('../data/events/*.json',{eager:true,import:'default'}));
const now=Date.now();
const upcoming=all.filter(e=>e && e.status==='published' && e.id && e.start && e.title && !Number.isNaN(Date.parse(e.start)) && Date.parse(e.end||e.start)>=now).map(e=>({...e,category:classifyEvent(e)})).sort((a,b)=>Date.parse(a.start)-Date.parse(b.start)).slice(0,5);
const highlights=[
 listings.find(x=>x.id==='brightside'),
 listings.find(x=>x.id==='flagcsa'),
 listings.find(x=>x.id==='pizzicletta')
].filter(Boolean);
const eventDate=(v)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',month:'short',day:'numeric'}).format(new Date(v));
const eventTime=(v)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',hour:'numeric',minute:'2-digit'}).format(new Date(v));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#123e35"/><meta name="description" content="Discover Flagstaff's local shops, independent businesses, real food from Northern Arizona farms, farmers markets, and arts and cultural events. Shop local. Eat local. Experience Flagstaff."/><title>FlagMade | Shop Local, Eat Real Food & Discover Flagstaff</title><link rel="canonical" href="https://flagmade.pages.dev/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="robots" content="noindex, nofollow, noarchive"/></head>
<body><SiteHeader active="Home" />
<main>
<section class="home-hero"><div class="container home-hero-inner">
<p class="home-kicker">MADE IN · GROWN IN · HAPPENING IN FLAGSTAFF</p>
<h1>Discover the <em>local</em> side of Flagstaff.</h1>
<p class="home-lede">Shop independent. Find real food. Explore the art, makers, markets, and experiences that give our mountain town its character.</p>
<div class="home-actions"><a class="home-button home-button-primary" href="/directory/">Shop local <span aria-hidden="true">↗</span></a><a class="home-button home-button-outline" href="/events/">Explore events <span aria-hidden="true">↗</span></a></div>
</div></section>
<section class="container home-pillar-section" aria-labelledby="explore-heading"><div class="home-section-head"><div><p class="home-overline">YOUR LOCAL FIELD GUIDE</p><h2 id="explore-heading">Less ordinary. More Flagstaff.</h2></div><p>Find where to go, what to do, and who to support—with the local businesses and people behind it all.</p></div>
<div class="home-pillars">
<a class="home-pillar" href="/directory/"><span class="home-index">01 / SHOP</span><span class="home-pillar-mark" aria-hidden="true">↗</span><h3>Shop local</h3><p>Independent boutiques, bookstores, makers, neighborhood shops, and places worth knowing.</p><span class="home-pillar-link">Explore local businesses →</span></a>
<a class="home-pillar home-pillar-food" href="/local-food/"><span class="home-index">02 / EAT</span><span class="home-pillar-mark" aria-hidden="true">↗</span><h3>Real food</h3><p>Farmers markets, farmstands, CSAs, and Northern Arizona growers. Know where your food comes from.</p><span class="home-pillar-link">Find local food →</span></a>
<a class="home-pillar home-pillar-events" href="/events/"><span class="home-index">03 / GO</span><span class="home-pillar-mark" aria-hidden="true">↗</span><h3>Arts &amp; culture</h3><p>Live music, art, theater, science, history, markets, and creative happenings around town.</p><span class="home-pillar-link">Open the events calendar →</span></a>
</div></section>
<section class="home-now"><div class="container"><div class="home-section-head"><div><p class="home-overline">WHAT'S HAPPENING</p><h2>Coming up in Flagstaff</h2></div><a class="home-text-link" href="/events/">View the full calendar →</a></div>
{upcoming.length?<div class="home-events">{upcoming.map(e=><a class="home-event" href={'/events/?q='+encodeURIComponent(e.title)}><span class="home-event-date">{eventDate(e.start)}</span><span class="home-event-info"><strong>{e.title}</strong><small>{e.organization} · {e.allDay?'All day':eventTime(e.start)}</small></span><span class="home-event-arrow" aria-hidden="true">↗</span></a>)}</div>:<div class="home-no-events">New local events are added regularly. <a href="/events/">Explore the calendar →</a></div>}
</div></section>
<section class="container home-story"><div class="home-story-visual"><span class="home-stamp">LOCAL ROOTS<br/>GOOD THINGS</span><span class="home-story-large" aria-hidden="true">F<span>✳</span></span></div><div class="home-story-copy"><p class="home-overline">BEYOND THE CHAIN STORES</p><h2>A town worth keeping local.</h2><p>Flagstaff is full of people making things, growing food, running independent shops, and creating experiences you won't find just anywhere.</p><p>FlagMade brings those places and happenings together so it's easier to spend locally, eat seasonally, and discover what's around the corner.</p><a class="home-button home-button-primary" href="/directory/">Explore the directory ↗</a></div></section>
<section class="home-last"><div class="container"><p class="home-overline">START EXPLORING</p><h2>Good things are happening here.</h2><div class="home-last-actions"><a href="/local-food/">Find farmers markets ↗</a><a href="/directory/">Discover local shops ↗</a><a href="/events/">See upcoming events ↗</a></div></div></section>
</main><SiteFooter /></body></html>