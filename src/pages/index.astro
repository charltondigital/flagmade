---
import '../styles/global.css';
import '../styles/home.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {listings,placePath} from '../data/directory.js';
import {classifyEvent} from '../lib/event-categories.js';
const all=Object.values(import.meta.glob('../data/events/*.json',{eager:true,import:'default'}));
const now=Date.now();
const upcoming=all.filter(e=>e && e.status==='published' && e.id && e.start && e.title && !Number.isNaN(Date.parse(e.start)) && Date.parse(e.end||e.start)>=now).map(e=>({...e,category:classifyEvent(e)})).sort((a,b)=>Date.parse(a.start)-Date.parse(b.start)).slice(0,5);
const highlights=[
 listings.find(x=>x.id==='brightside'),
 listings.find(x=>x.id==='flagcsa'),
 listings.find(x=>x.id==='pizzicletta')
].filter(Boolean);
const eventDate=(v)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',month:'short',day:'numeric'}).format(new Date(v));
const eventTime=(v)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',hour:'numeric',minute:'2-digit'}).format(new Date(v));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#006E52"/><meta name="description" content="Find Flagstaff events, independent shops, farmers markets, farmstands and local food."/><title>FlagMade | Shop Local, Eat Real Food & Discover Flagstaff</title><link rel="canonical" href="https://flagmade.pages.dev/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="robots" content="noindex, nofollow, noarchive"/></head>
<body><SiteHeader active="Home" />
<main>
<section class="home-hero"><div class="container home-hero-inner">
  <div class="home-hero-copy">
    <p class="home-kicker">FLAGSTAFF, ARIZONA</p>
    <h1>Events, shops <span>&amp;</span> local food</h1>
    <p class="home-lede">Discover what’s happening and where to shop, eat and explore in Flagstaff.</p>
    <div class="home-actions"><a class="home-button home-button-primary" href="/events/">Browse events <span aria-hidden="true">↗</span></a><a class="home-button home-button-outline" href="/directory/">Explore businesses <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="home-hero-panel" aria-hidden="true"><span class="home-panel-small">SHOP LOCAL</span><strong>FLG<span>✳</span></strong><span class="home-panel-bottom">MADE HERE. FOUND HERE.</span></div>
</div></section>
<section class="container home-pillar-section" aria-labelledby="explore-heading">
  <div class="home-section-head"><h2 id="explore-heading">Explore Flagstaff</h2></div>
  <div class="home-pillars">
    <a class="home-pillar home-pillar-events" href="/events/"><span class="home-pillar-label">01 / DO</span><h3>Events</h3><p>Concerts, art, markets, talks and performances</p><span class="home-pillar-link">View calendar ↗</span></a>
    <a class="home-pillar home-pillar-shop" href="/directory/"><span class="home-pillar-label">02 / SHOP</span><h3>Local businesses</h3><p>Independent stores, makers and neighborhood favorites</p><span class="home-pillar-link">Browse directory ↗</span></a>
    <a class="home-pillar home-pillar-food" href="/local-food/"><span class="home-pillar-label">03 / EAT</span><h3>Local food</h3><p>Farmstands, farmers markets, CSAs and growers</p><span class="home-pillar-link">Find local food ↗</span></a>
  </div>
</section>
<section class="home-now"><div class="container">
  <div class="home-section-head"><h2>Upcoming events</h2><a class="home-text-link" href="/events/">All events ↗</a></div>
  {upcoming.length?<div class="home-events">{upcoming.map(e=><a class="home-event" href={'/events/?q='+encodeURIComponent(e.title)}><span class="home-event-date">{eventDate(e.start)}</span><span class="home-event-info"><strong>{e.title}</strong><small>{e.organization} · {e.allDay?'All day':eventTime(e.start)}</small></span><span class="home-event-arrow" aria-hidden="true">↗</span></a>)}</div>:<div class="home-no-events">No upcoming events listed. <a href="/events/">Open calendar ↗</a></div>}
</div></section>
</main><SiteFooter /></body></html>