---
import '../../styles/global.css';
export function getStaticPaths(){
 const all=Object.values(import.meta.glob('../../data/events/*.json',{eager:true,import:'default'}));
 return all.filter(e=>e.status==='published'&&e.title&&e.start).map((event,i)=>({params:{id:(event.id||event.title.toLowerCase().replace(/[^a-z0-9]+/g,'-'))+'-'+i},props:{event}}));
}
const {event}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{event.title} — Flagmade</title></head><body><header class="site-header"><div class="header-inner container"><a class="brand" href="/">flagmade</a><nav><a href="/">Events</a><a href="/directory/">Directory</a><a href="/search/">Search</a></nav></div></header><main class="container"><article data-pagefind-body><h1>{event.title}</h1><p>{event.organization}</p><p>{event.category}</p><p>{event.start}</p><p>{event.venue}</p><p>{event.description}</p><p>{event.price}</p><a href={event.url} rel="noopener noreferrer">Organizer details ↗</a></article><p><a href="/">Back to events</a></p></main></body></html>