---
import '../styles/global.css';
const groups=[
{heading:'Markets',items:[
{name:'Flagstaff Community Market',markets:[
{name:'Sunday Farmers Market',location:'City Hall, 211 W Aspen Ave',schedule:'Sundays, 8 AM–1 PM · May–October',url:'https://www.flagstaffmarket.com/sunday-farmers-market.html'},
{name:'Urban Flea Market',location:'City Hall, 211 W Aspen Ave',schedule:'Second & fourth Saturdays, 9 AM–2 PM · June–October',url:'https://www.flagstaffmarket.com/flagstaff-urban-flea-market.html'},
{name:'Sleigh Winter Market',location:'City Hall, 211 W Aspen Ave',schedule:'December 5–6, 2026 · 11 AM–3 PM',url:'https://www.flagstaffmarket.com/sleigh-holiday-market.html'}
],products:'Farmers market: produce, meat, eggs and honey. Flea and winter markets: crafts, specialty foods and changing vendor selections.'},
{name:'Flagstaff Mountain Town Market',markets:[
{name:'Wednesday Farmers Market',location:'Heritage Square',schedule:'Wednesdays, 3–7 PM · May–October',url:'https://downtownflagstaff.org/events/wednesday-farmers-market'},
{name:'Saturday Farmers Market',location:'Pine Forest School, Fourth & Cedar',schedule:'Saturdays, 9 AM–1 PM · May–October',url:'https://www.flagstaffarizona.org/blog/farmers-market-offer-fresh-vegetables-and-flowers/'},
{name:'Winter / Spring Sunday Market',location:'City Hall, 211 W Aspen Ave',schedule:'Sundays, 9 AM–1 PM · November–April (check current season)',url:'https://downtownflagstaff.org/do/flagstaff-mountain-town-market-1'}
],products:'Regional produce, bread, meat, dairy, eggs, honey, plants and other local foods; vendor availability varies.'},
{name:'East Flagstaff Community Market',location:'Flagstaff Mall parking lot, near Desert Financial Credit Union',schedule:'Third Saturdays, 8 AM–1 PM · May–September',products:'Mainly crafts, art and prepared food; farm produce not regularly confirmed',url:'https://eastflagcm.com/'}
]},
{heading:'Stores & farmstands',items:[
{name:'Flagstaff CSA & Local Market',location:'116 W Cottage Ave',schedule:'Mon–Sat, 10 AM–6 PM; Sun, 10 AM–2 PM',products:'Arizona produce, meat, dairy, eggs and pantry staples; not all inventory is Northern Arizona-grown',url:'https://www.flagcsa.com/local-market'},
{name:'Forestdale Farmstand',location:'455 S Beech Dr',schedule:'Daytime self-service; seasonal produce generally mid-May to early December (confirm before visiting)',products:'Flagstaff-grown produce, eggs and honey',url:'https://forestdalefarm.com/farmstand-2/'}
]},
{heading:'Order & pickup',items:[
{name:'Flagstaff CSA subscriptions and online orders',location:'Pickup at 116 W Cottage Ave; delivery options',schedule:'Weekly produce boxes and à-la-carte online ordering',products:'Produce and groceries; verify each item’s farm origin',url:'https://www.flagcsa.com/csa-subscriptions'},
{name:'Forestdale Farm CSA',location:'Forestdale Farm, 455 S Beech Dr',schedule:'Seasonal farm shares; check current enrollment',products:'Locally grown vegetables and herbs',url:'https://forestdalefarm.com/'}
]}
];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#fff"/><title>Local Food — Flagmade</title><meta name="description" content="Where to buy locally grown and produced food in Flagstaff, Arizona: markets, farmstands, groceries and CSA pickup."/><link rel="canonical" href="https://flagmade.pages.dev/local-food/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body>
<header class="site-header"><div class="header-inner container"><a class="brand" href="/">flagmade</a><nav aria-label="Main navigation"><a href="/">Events</a><a href="/local-food/" aria-current="page">Local Food</a></nav></div></header>
<main class="container food-page">
<h1>Local Food</h1>
<p class="food-intro">Where to buy food grown, raised or produced in Northern Arizona.</p>
{groups.map(group=><section class="food-section"><h2>{group.heading}</h2><div class="food-grid">{group.items.map(item=><article class="food-card"><h3>{item.markets ? item.name : <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name} ↗</a>}</h3>{item.markets ? <div class="market-options">{item.markets.map(market=><div class="market-option"><a href={market.url} target="_blank" rel="noopener noreferrer"><strong>{market.name} ↗</strong></a><p>{market.location}</p><p>{market.schedule}</p></div>)}</div> : <><p><strong>Where:</strong> {item.location}</p><p><strong>When:</strong> {item.schedule}</p></>}<p><strong>Food:</strong> {item.products}</p></article>)}</div></section>)}
<p class="food-note">Dates, hours and availability can change. Check the linked source before visiting. The focus is food produced in Northern Arizona; some retailers also carry products from elsewhere.</p>
</main></body></html>
