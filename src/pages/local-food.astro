<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#fff"/><title>Local Food — Flagmade</title><meta name="description" content="A calendar of farmers, flea, and artisan markets in Flagstaff, organized by host."/><link rel="canonical" href="https://flagmade.pages.dev/local-food/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="robots" content="noindex, nofollow, noarchive"/></head>
<body>
<div class="construction-banner" role="status"><strong>Under construction.</strong> Flagmade is being developed; listings and schedules may change.</div>
<header class="site-header"><div class="header-inner container"><a class="brand" href="/">flagmade</a><nav aria-label="Main navigation"><a href="/">Events</a><a href="/local-food/" aria-current="page">Local Food</a><a href="/directory/">Directory</a><a href="/search/">Search</a></nav></div></header>
<main class="container food-page market-only">
<h1>Local Food</h1>
<p class="food-intro">Flagstaff markets, farmstands and community-supported agriculture.</p>
<div class="food-tabs" role="tablist" aria-label="Local food categories"><button class="food-tab active" id="tab-markets" type="button" role="tab" aria-selected="true" aria-controls="panel-markets">Markets</button><button class="food-tab" id="tab-farmstands" type="button" role="tab" aria-selected="false" aria-controls="panel-farmstands" tabindex="-1">Farmstands</button><button class="food-tab" id="tab-csas" type="button" role="tab" aria-selected="false" aria-controls="panel-csas" tabindex="-1">CSAs</button></div>
<div id="panel-markets" role="tabpanel" aria-labelledby="tab-markets">
<div class="market-legend" aria-label="Market organizers">
{hosts.map(host=><div class={"market-legend-item host-"+host.id}><span class="market-swatch" aria-hidden="true"></span>{host.name}</div>)}
</div>
<section class="market-calendar" aria-labelledby="market-calendar-title">
<h2 id="market-calendar-title">Markets by date</h2>
<div class="market-cal-controls"><button id="market-prev" type="button" aria-label="Previous month">←</button><strong id="market-month"></strong><button id="market-next" type="button" aria-label="Next month">→</button><button id="market-today" type="button">Current month</button></div>
<div class="market-cal-grid" id="market-grid" aria-label="Calendar by month"></div>

<p class="market-cal-note">July–October 2026 dates are generated from published recurring schedules, not individually verified attendance. Weather and cancellations may affect individual dates. Future seasons will appear when their schedules are confirmed.</p>
</section>
</div>
<section id="panel-farmstands" role="tabpanel" aria-labelledby="tab-farmstands" hidden><h2>Farmstands & local food shops</h2><div class="food-grid">
<article class="food-card"><h3>Forestdale Farmstand</h3><p>455 S Beech Dr · Seasonal, generally mid-May through early December. Flagstaff-grown vegetables, eggs and honey.</p><a href="https://forestdalefarm.com/farmstand-2/" target="_blank" rel="noopener noreferrer">Farmstand information ↗</a></article>
<article class="food-card"><h3>Flagstaff CSA & Local Market</h3><p>116 W Cottage Ave · Mon–Sat, 10 AM–6 PM; Sun, 10 AM–2 PM. Arizona produce, meat, dairy, eggs and groceries; not everything is Northern Arizona-grown.</p><a href="https://www.flagcsa.com/local-market" target="_blank" rel="noopener noreferrer">Store information ↗</a></article>
</div></section>
<section id="panel-csas" role="tabpanel" aria-labelledby="tab-csas" hidden><h2>Community-supported agriculture</h2><div class="food-grid">
<article class="food-card"><h3>Flagstaff CSA</h3><p>Weekly produce subscriptions and online ordering, with pickup at 116 W Cottage Ave and delivery options. Farm origins vary.</p><a href="https://www.flagcsa.com/csa-subscriptions" target="_blank" rel="noopener noreferrer">Subscriptions & pickup ↗</a></article>
<article class="food-card"><h3>Forestdale Farm CSA</h3><p>Seasonal shares of locally grown vegetables and herbs. Check the farm for current enrollment.</p><a href="https://forestdalefarm.com/" target="_blank" rel="noopener noreferrer">Farm shares ↗</a></article>
</div></section>
<dialog id="market-detail" class="market-detail-dialog" aria-labelledby="market-detail-name"><div class="market-dialog-head"><h2 id="market-detail-name"></h2><button type="button" id="market-dialog-close" aria-label="Close details">×</button></div><p id="market-detail-host"></p><dl><dt>Date</dt><dd id="market-detail-date"></dd><dt>Hours</dt><dd id="market-detail-time"></dd><dt>Location</dt><dd id="market-detail-location"></dd></dl><p id="market-detail-description"></p><a id="market-detail-url" target="_blank" rel="noopener noreferrer">Official event information ↗</a></dialog>
</div>
<section class="food-tab-panel" id="panel-farmstands" role="tabpanel" aria-labelledby="tab-farmstands" hidden><h2>Farmstands & shops</h2><div class="food-grid">
<article class="food-card"><h3>Forestdale Farmstand</h3><p>455 S Beech Dr, Flagstaff</p><p>Seasonal local produce, eggs and honey; hours and inventory vary.</p><a href="https://forestdalefarm.com/farmstand-2/" target="_blank" rel="noopener noreferrer">Farmstand information ↗</a></article>
<article class="food-card"><h3>Flagstaff CSA & Local Market</h3><p>116 W Cottage Ave, Flagstaff</p><p>Produce, meat, dairy and groceries; not all items are grown in Northern Arizona.</p><a href="https://www.flagcsa.com/local-market" target="_blank" rel="noopener noreferrer">Shop information ↗</a></article>
</div></section>
<section class="food-tab-panel" id="panel-csas" role="tabpanel" aria-labelledby="tab-csas" hidden><h2>CSAs</h2><p>Community-supported agriculture programs offer produce shares or subscriptions. Check enrollment and pickup schedules with the farm.</p><div class="food-grid">
<article class="food-card"><h3>Forestdale Farm CSA</h3><p>Flagstaff-grown seasonal produce shares.</p><a href="https://forestdalefarm.com/" target="_blank" rel="noopener noreferrer">CSA information ↗</a></article>
<article class="food-card"><h3>Flagstaff CSA</h3><p>Produce boxes and online groceries, with pickup at 116 W Cottage Ave and possible delivery options.</p><a href="https://www.flagcsa.com/csa-subscriptions" target="_blank" rel="noopener noreferrer">Subscription information ↗</a></article>
</div></section>
<script id="market-data" type="application/json" set:html={JSON.stringify(marketDates).replace(/</g,'\\u003c')}></script>
<script>
const records=JSON.parse(document.getElementById('market-data').textContent);
const tabs=[...document.querySelectorAll('.food-tabs [role="tab"]')];
function activateTab(id,focus=false){
 for(const tab of tabs){const chosen=tab.id===id;tab.setAttribute('aria-selected',String(chosen));tab.tabIndex=chosen?0:-1;document.getElementById(tab.getAttribute('aria-controls')).hidden=!chosen;if(chosen&&focus)tab.focus();}
 if(history.replaceState)history.replaceState(null,'','#'+id.slice(4));
}
tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activateTab(tab.id));tab.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();activateTab(tabs[(index+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length].id,true);}});});
if(['markets','farmstands','csas'].includes(location.hash.slice(1)))activateTab('tab-'+location.hash.slice(1));
const dateParts=new Intl.DateTimeFormat('en-US',{timeZone:'America/Phoenix',year:'numeric',month:'2-digit'}).formatToParts(new Date());
const todayYear=Number(dateParts.find(p=>p.type==='year').value),todayMonth=Number(dateParts.find(p=>p.type==='month').value)-1;
let year=todayYear,month=todayMonth;
const grid=document.getElementById('market-grid'),monthName=document.getElementById('market-month');
const dialog=document.getElementById('market-detail');
const hostClass=host=>host==='Flagstaff Community Market'?'community':host==='Flagstaff Mountain Town Market'?'mountain':'east';
const prettyDate=date=>new Date(date+'T12:00:00Z').toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
function openDetail(e){
 document.getElementById('market-detail-name').textContent=e.name;
 document.getElementById('market-detail-host').textContent=e.operator;
 document.getElementById('market-detail-date').textContent=prettyDate(e.date);
 document.getElementById('market-detail-time').textContent=e.time;
 document.getElementById('market-detail-location').textContent=e.location;
 document.getElementById('market-detail-description').textContent=e.details||'';
 document.getElementById('market-detail-url').href=e.url;
 if(dialog.showModal)dialog.showModal();else dialog.setAttribute('open','');
}
document.getElementById('market-dialog-close').onclick=()=>dialog.close();
dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
function makeEvent(e){
 const btn=document.createElement('button');btn.type='button';btn.className='market-calendar-event host-'+hostClass(e.operator);
 const label=document.createElement('span');label.textContent=e.name;
 const when=document.createElement('small');when.textContent=e.time;
 btn.append(label,when);btn.addEventListener('click',()=>openDetail(e));return btn;
}
function draw(){
 const first=new Date(Date.UTC(year,month,1)),key=year+'-'+String(month+1).padStart(2,'0');
 monthName.textContent=first.toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
 grid.replaceChildren();
 for(const name of ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']){const el=document.createElement('div');el.className='market-weekday';el.textContent=name;grid.append(el);}
 for(let i=0;i<first.getUTCDay();i++){const el=document.createElement('div');el.className='market-day blank';grid.append(el);}
 const events=records.filter(e=>e.date.startsWith(key));
 const days=new Date(Date.UTC(year,month+1,0)).getUTCDate();
 for(let d=1;d<=days;d++){
  const cell=document.createElement('div');cell.className='market-day';
  const num=document.createElement('span');num.className='day-num';num.textContent=d;cell.append(num);
  const date=key+'-'+String(d).padStart(2,'0');
  events.filter(e=>e.date===date).forEach(e=>cell.append(makeEvent(e)));
  grid.append(cell);
 }
}
document.getElementById('market-prev').onclick=()=>{month--;if(month<0){month=11;year--;}draw();};
document.getElementById('market-next').onclick=()=>{month++;if(month>11){month=0;year++;}draw();};
document.getElementById('market-today').onclick=()=>{year=todayYear;month=todayMonth;draw();};
draw();
const tabs=[...document.querySelectorAll('.food-tab')];
function showTab(btn){for(const tab of tabs){const active=tab===btn;tab.classList.toggle('active',active);tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;document.getElementById(tab.getAttribute('aria-controls')).hidden=!active;}}
for(const tab of tabs){tab.addEventListener('click',()=>{showTab(tab);history.replaceState(null,'','#'+tab.id.slice(4));});tab.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const next=tabs[(tabs.indexOf(tab)+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];showTab(next);next.focus();}});}
const initial=tabs.find(t=>'#'+t.id.slice(4)===location.hash);if(initial)showTab(initial);
</script>
<p class="food-note">Dates, hours and availability can change. Check the linked source before visiting. The focus is food produced in Northern Arizona; some retailers also carry products from elsewhere.</p>
</main></body></html>
