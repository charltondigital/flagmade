---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import PageHero from '../../components/PageHero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { listings, placePath } from '../../data/directory.js';
export function getStaticPaths(){
  return listings.map(place=>({params:{id:place.id},props:{place}}));
}
const {place}=Astro.props;
const canonicalPath=placePath(place);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={place.description}/><link rel="canonical" href={"https://flagmade.pages.dev"+canonicalPath}/><title>{place.name} — Flagmade</title><meta name="robots" content="noindex, nofollow, noarchive"/></head><body><SiteHeader active="Directory" /><PageHero title={place.name} subtitle={place.category} /><main class="container place-page"><article data-pagefind-body><section class="place-about"><h2>About this business</h2><p>{place.description}</p></section><section class="place-visit"><h2>Visit</h2><p>{place.address}</p></section><div class="place-detail-links"><a href={place.url} target="_blank" rel="noopener noreferrer">Official website ↗</a><a class="get-directions" href={"https://www.google.com/maps/dir/?api=1&destination="+encodeURIComponent(place.address)} data-address={place.address} target="_blank" rel="noopener noreferrer">Get directions ↗</a></div></article><p><a href="/directory/">Back to Directory</a></p></main><SiteFooter />
<script>
  // One visible link: delegate to native mapping URL handlers on mobile,
  // with a conventional HTTPS destination for desktop/unsupported clients.
  const link = document.querySelector('.get-directions');
  if (link) {
    const address = link.dataset.address;
    const encoded = encodeURIComponent(address);
    const ua = navigator.userAgent || '';
    if (/iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
      link.href = 'https://maps.apple.com/?daddr=' + encoded;
    } else if (/Android/i.test(ua)) {
      link.href = 'geo:0,0?q=' + encoded;
      link.removeAttribute('target');
    }
  }
</script>
</body></html>