---
import '../../styles/global.css';
import { listings } from '../../data/directory.js';
export function getStaticPaths(){
  return listings.map(place=>({params:{id:place.id},props:{place}}));
}
const {place}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{place.name} — Flagmade</title></head><body><header class="site-header"><div class="header-inner container"><a class="brand" href="/">flagmade</a><nav><a href="/">Events</a><a href="/directory/">Directory</a><a href="/search/">Search</a></nav></div></header><main class="container"><article data-pagefind-body><h1>{place.name}</h1><p>{place.type}</p><p>{place.description}</p><p>{place.address}</p><a href={place.url} rel="noopener noreferrer">Business website ↗</a></article><p><a href="/directory/">Back to Directory</a></p></main></body></html>