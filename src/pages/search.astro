---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Search — Flagmade</title><link rel="stylesheet" href="/pagefind/pagefind-ui.css"/><meta name="robots" content="noindex, nofollow, noarchive"/></head><body><SiteHeader active="Search" /><PageHero title="Search" subtitle="Find events, businesses and places around Flagstaff." /><main class="container search-page"><div id="flagmade-search"></div></main><SiteFooter /><script src="/pagefind/pagefind-ui.js" defer></script><script is:inline>document.addEventListener('DOMContentLoaded',()=>{if(window.PagefindUI)new PagefindUI({element:'#flagmade-search',showSubResults:true,showImages:false});});</script></body></html>